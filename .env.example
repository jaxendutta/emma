# PubMed API (from A1/A2 — optional, for live AMG-RAG retrieval)
NCBI_EMAIL=your-email@uottawa.ca
NCBI_API_KEY=your-key-here

# Paths (override if your data lives elsewhere)
DATA_DIR=./data
MODELS_DIR=./models

# GitHub (for cloning the repo and pushing changes)
GITHUB_REPO_URL=https://github.com/jaxendutta/emma.git

# Ollama (local — no key needed, just make sure ollama is running)
OLLAMA_BASE_URL=http://localhost:11434

# Hugging Face
HF_TOKEN=your-hf-token-here

# ── Cloud LLM / RAG (required for natural conversational responses) ────────────
# Set EMMA_USE_RAG=true to enable. At least one of GEMINI_API_KEY or GROQ_API_KEY
# must also be provided. Gemini is tried first; Groq is the fallback.
EMMA_USE_RAG=true

# Google Gemini API key — get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# (Optional) Which Gemini model to use. Defaults to gemini-1.5-flash.
# EMMA_GEMINI_MODEL=gemini-1.5-flash

# Groq API key (fallback if Gemini is unavailable) — free at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
